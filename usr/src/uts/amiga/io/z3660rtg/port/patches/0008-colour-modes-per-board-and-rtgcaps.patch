     unsigned short zorro;         /* GETINFO.zorro */
     unsigned short product;       /* GETINFO.product */
     unsigned short flags;         /* ZZ9K_BT_* */
-};
+    unsigned short colormodes;    /* ZZ9K_CM(ZZ9K_COLOR_*) the board can show */
+};

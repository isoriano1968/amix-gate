#!/bin/sh
#
# S99zz9000 - late SysV init hook for the AMIX ZZ9000 RTG console.
#
# Install as /etc/rc2.d/S99zz9000, or into the equivalent AMIX run-level
# directory used after filesystems and the normal console are initialized.

PATH=/sbin:/usr/sbin:/usr/bin:/usr/amiga/bin
export PATH

DEV=/dev/zz9000
TEST=/usr/amiga/bin/zz9k_test

case "$1" in
''|start)
	# No device node or no board (another card, or none): nothing to do and
	# nothing to say.  zz9k_test names the board it found (ZZ9000 or Z3660
	# RTG) when it switches the console.
	[ -r "$DEV" ] || exit 0
	[ -x "$TEST" ] && "$TEST" "$DEV" redirect >/dev/console 2>&1
	;;

stop)
	[ -r "$DEV" ] || exit 0
	[ -x "$TEST" ] && "$TEST" "$DEV" noconsole >/dev/console 2>&1
	;;

*)
	echo "usage: $0 {start|stop}"
	exit 2
	;;
esac

exit 0

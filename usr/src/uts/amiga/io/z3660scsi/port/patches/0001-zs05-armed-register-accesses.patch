+#define	Z3660_RING(arm,cmd,val)	do { (void)RDLONG(arm); WRLONG(cmd,val); } while (0)
+#define	Z3660_RDX(arm,cmd,v)	do { (void)RDLONG(arm); (v) = RDLONG(cmd); } while (0)
+#define	Z3660_RDA(cmd,v)	Z3660_RDX(cmd,cmd,v)
+#endif
 

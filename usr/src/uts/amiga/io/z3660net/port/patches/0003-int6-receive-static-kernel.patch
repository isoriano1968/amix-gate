+#ifdef Z3660ETH_STATIC_INTR
+/*
+ * A static kernel: the handlers are wired by the relink, not attached, and
+ * the switch is z3660eth_intr in /dev/kmem, looked at in every poll tick (and
+ * level-2 drain): 6 turns INT6 receive on after the level-6 self-test (a
+ * software EXTER, polled here: level 6 passes the tick's IPL), 0 turns it
+ * off again.  The poll tick drains every tick in both modes.
+ */
+static void
+z3660eth_intr_switch(board_index)
+int board_index;
+{
+    z3660eth_board_t *board = &z3660eth_board[board_index];
+    z3660eth_info_t *info = &board->z3660eth_info;
+    int i;
+
+    if (info->regs == 0 || board->z3660eth_status.board_state != Z3660ETH_BOARD_RUNNING)
+	return;
+    if (z3660eth_intr == 6 && z3660eth_intr_mode != 6) {
+	z3660eth_l2_test = 0;
+	z3660eth_l6_test = 1;
+	RAISE_INTREQ(INTREQ_EXTER);
+	for (i = 0; i < Z3660ETH_SELFTEST_SPIN && z3660eth_l6_test; i++)
+	    ;
+	if (z3660eth_l6_test) {
+	    z3660eth_l6_test = 0;
+	    z3660eth_intr = 0;
+	    cmn_err(CE_NOTE, "zen: INT6 self-test failed (p6int not wired?); polled");
+	    return;
+	}
+	z3660eth_intr_mode = 6;
+	z3660eth_int_pending = 0;
+	z3660eth_int_on = 1;
+	Z3660ETH_CONFIG(info->regs, ZZ_CONFIG_ENABLE);
+	cmn_err(CE_NOTE, "zen: INT6 receive on, drain at %s", z3660eth_intrl2 ?
+	    "level 2" : "the poll tick");
+    } else if (z3660eth_intr != 6 && z3660eth_intr_mode == 6) {
+	z3660eth_int_on = 0;
+	Z3660ETH_CONFIG(info->regs, ZZ_CONFIG_DISABLE);
+	z3660eth_int_pending = 0;
+	z3660eth_intr_mode = 0;
+	cmn_err(CE_NOTE, "zen: INT6 receive off; polled");
+    }
+}
+
+/*
+ * What the relink puts in place of the stock handlers: p6int's call of the
+ * CIA-B handler and an int2_tbl entry come here, and the handler that was
+ * there runs first, as before.  Which one that is, the relink writes into
+ * these pointers (its relocation is retargeted with the site's), so another
+ * relink step that took the int2_tbl slot first (the Hydra driver) is kept.
+ */
+extern int aciabintr(), aenintr();
+int (*z3660eth_p6_next)() = aciabintr;
+int (*z3660eth_p2_next)() = aenintr;
+
+int
+z3660eth_p6(a, b)
+char *a, *b;
+{
+    int r = (*z3660eth_p6_next)(a, b);
+
+    (void)z3660eth_int6((char *)&z3660eth_board[0]);
+    return r;
+}
+
+int
+z3660eth_p2(a, b)
+char *a, *b;
+{
+    int r = (*z3660eth_p2_next)(a, b);
+
+    (void)z3660eth_int2((char *)&z3660eth_board[0]);
+    return r;
+}
+#endif	/* Z3660ETH_STATIC_INTR */
+
+#endif	/* Z3660ETH_INTR */
